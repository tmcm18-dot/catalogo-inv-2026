# Herramienta local de revisión de integridad del catálogo.
# Nunca habilitar en Vercel Production ni Preview.
# Usar `npm run review:catalog` (define CATALOG_REVIEW_MODE=1 de forma segura).
CATALOG_REVIEW_MODE=0

# Playwright Nivel 1 (solo Vercel Preview; nunca Production).
# PLAYWRIGHT_BASE_URL=https://catalogo-inv-2026-<hash>-maxi20.vercel.app
# VERCEL_AUTOMATION_BYPASS_SECRET=

# --- Auth / DB (Fase 1) ---
# Embedded Postgres local: npm run db:dev  (imprime DATABASE_URL)
DATABASE_URL=

# Origen canónico de la app (validación CSRF/Origin en mutaciones)
APP_ORIGIN=http://localhost:3000

# Secretos (mínimo 32 caracteres). No versionar valores reales.
SESSION_SECRET=
TOTP_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY=

# Email: stub en desarrollo (loguea enlaces en consola). Proveedor real en fases posteriores.
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM=

# TOTP
TOTP_ISSUER=Catalogo INV 2026

# CAPTCHA adaptativo (mock en desarrollo; Turnstile Managed en producción)
CAPTCHA_PROVIDER=mock
# CAPTCHA_ALLOW_MOCK=1
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Rate limit store (Memory por defecto). Redis opcional para despliegues multi-instancia.
# RATE_LIMIT_STORE=memory
# REDIS_URL=

# WhatsApp (pedido actual sigue usando deep link; destino futuro configurable)
# WHATSAPP_DESTINATION_NUMBER=

# Seed opcional de SUPERADMIN en desarrollo (sin valores por defecto).
# Preferir: npm run admin:create
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# --- E2E auth fixtures (solo local / Preview aislada; nunca Production) ---
# node scripts/e2e/seed-auth-fixtures.mjs
# E2E_CUSTOMER_EMAIL=
# E2E_CUSTOMER_PASSWORD=
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_ADMIN_2FA_EMAIL=
# E2E_ADMIN_2FA_PASSWORD=
# E2E_ADMIN_2FA_TOTP_SECRET=
# E2E_SUPER_EMAIL=
# E2E_SUPER_PASSWORD=
# E2E_SUPER_TOTP_SECRET=
# E2E_SUPER_B_EMAIL=
# E2E_SUPER_B_PASSWORD=
# E2E_SUPER_B_TOTP_SECRET=
